a:126:{s:7:"address";s:31:"Surabaya, Jawa Timur, Indonesia";s:13:"autoslideshow";s:1:"1";s:19:"availablecoursetype";s:1:"1";s:16:"backToTop_status";s:1:"1";s:16:"comboListboxType";s:1:"1";s:16:"copyright_footer";s:135:"Copyright &copy; 2026 - Developed by <a href="http://lmsace.com">Kelompok_7.com</a>. Powered by <a href="https://moodle.org">Moodle</a>";s:9:"customcss";s:0:"";s:7:"emailid";s:19:"admin@aksimoodle.id";s:7:"favicon";s:28:"/Desain tanpa judul (27).png";s:8:"fontsize";s:2:"16";s:15:"footerb1_status";s:1:"1";s:15:"footerb2_status";s:1:"1";s:15:"footerb3_status";s:1:"1";s:15:"footerb4_status";s:1:"1";s:11:"footerbgimg";s:0:"";s:15:"footerbgOverlay";s:3:"0.4";s:13:"footerbtitle1";s:0:"";s:13:"footerbtitle2";s:25:"lang:footerbtitle2default";s:13:"footerbtitle3";s:25:"lang:footerbtitle3default";s:13:"footerbtitle4";s:25:"lang:footerbtitle4default";s:10:"footerlogo";s:28:"/Desain tanpa judul (29).png";s:14:"footlogostatus";s:1:"1";s:8:"footnote";s:415:"<p><strong data-path-to-node="3,0" data-index-in-node="0">Aksi Moodle LMS</strong> adalah platform pembelajaran digital yang dirancang untuk mendukung literasi teknologi dan pengembangan keterampilan secara mandiri. Melalui semangat Aktif, Kolaboratif, Solutif, dan Inovatif, kami menghadirkan pengalaman belajar yang modern dan relevan dengan kebutuhan industri masa depan.</p>
<p><a href="#">Read More »</a></p>";s:8:"infolink";s:92:"Beranda | #
