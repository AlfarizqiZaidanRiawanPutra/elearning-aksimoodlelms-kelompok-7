a:14:{s:10:"pluginname";s:17:"Soal kolom kustom";s:16:"privacy:metadata";s:64:"Pengaya kolom kustom soal tidak menyimpan data pengguna apa pun.";s:11:"customfield";s:23:"Pertanyaan kolom kustom";s:20:"customfield_islocked";s:8:"Terkunci";s:25:"customfield_islocked_help";s:209:"Jika kolom tersebut terkunci, hanya pengguna yang memiliki kemampuan untuk mengubah kolom kustom pertanyaan yang terkunci (pengguna dengan peran bawaan sebagai manajer) dapat mengubahnya di setelan pertanyaan.";s:22:"customfield_notvisible";s:15:"Tak seorang pun";s:22:"customfield_visibility";s:13:"Terlihat oleh";s:27:"customfield_visibility_help";s:76:"Setelan ini menentukan siapa yang dapat melihat nama dan nilai kolom kustom.";s:24:"customfield_visibletoall";s:12:"Setiap orang";s:29:"customfield_visibletoteachers";s:8:"Pengajar";s:19:"customfieldsettings";s:30:"Setelan kolom kustom soal umum";s:37:"customfields:changelockedcustomfields";s:37:"Ubah kolom kustom pertanyaan terkunci";s:34:"customfields:configurecustomfields";s:24:"Konfigurasi kolom kustom";s:35:"customfields:viewhiddencustomfields";s:41:"Lihat kolom kustom pertanyaan tersembunyi";}